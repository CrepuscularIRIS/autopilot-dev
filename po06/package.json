{
  "name": "@dsh-external/dsh-wish-specializer",
  "version": "0.9.1-autopilot.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrepuscularIRIS/autopilot-dev.git"
  },
  "homepage": "https://github.com/CrepuscularIRIS/autopilot-dev#readme",
  "bugs": {
    "url": "https://github.com/CrepuscularIRIS/autopilot-dev/issues"
  },
  "description": "Autopilot Dev — Wish-driven intent alignment and evidence-based Worker ↔ Advisor workflow for DSH PTC.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./check": {
      "default": "./lib/wish-check.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "playbooks",
    "runtime",
    "cordis.patch.yml",
    "README.md",
    "HELP-0.6.md",
    "HELP-0.6.en.md",
    "eval/HOLDOUT-v2.md",
    "eval/HOLDOUT-v1.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "immediately": true
    }
  }
}
